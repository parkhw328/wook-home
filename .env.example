# Local browser port. No AI credentials are required for the demo.
WOOK_PORT=8080
OFFICE_NAME=StackQueue Office

# Optional, server-side connection checks only. Never commit real values.
# Web subscriptions and CLI logins do not provide these API credentials.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Only needed for a Claude API key spanning multiple workspaces.
ANTHROPIC_WORKSPACE_ID=
GEMINI_API_KEY=
# GOOGLE_API_KEY is a fallback when GEMINI_API_KEY is empty.
GOOGLE_API_KEY=
# Meta Model API: MODEL_API_KEY takes precedence over META_API_KEY.
MODEL_API_KEY=
META_API_KEY=
